ENV=development

POSTGRES_USER=automata
POSTGRES_PASSWORD=automata_dev_password
POSTGRES_DB=automata_dev
POSTGRES_PORT=5433
DATABASE_URL=postgres://automata:automata_dev_password@localhost:5433/automata_dev?sslmode=disable

JWT_SECRET=change-me-to-a-random-32-byte-string

HTTP_PORT=8080
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_ALLOWED_ORIGINS=http://localhost:3000
WORKER_CONCURRENCY=4
WORKER_QUEUE_CAPACITY=64
HTTP_TRUSTED_PROXIES=
DATABASE_MAX_CONNS=10
EXECUTION_MAX_PENDING_RUNS=10000
EXECUTION_MAX_PENDING_PER_USER=100
EXECUTION_RUNS_PER_MINUTE=60
